[Unit]
Description=llama.cpp server per AI Desktop Assistant (LFM3-Omni)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=@LLAMA_SERVER@ -hf LiquidAI/LFM3-Omni-2B-GGUF:Q4_K_M --host 127.0.0.1 --port 8090 -c 8192 --reasoning off --no-reasoning-preserve --temp 0 --jinja --no-warmup --sleep-idle-seconds 300 @EXTRA_ARGS@
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=default.target
